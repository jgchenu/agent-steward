{
  "name": "agent-steward",
  "version": "0.1.0",
  "private": true,
  "description": "Your self-hosted agent counterpart. Bring your own coding-agent subscription.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node --env-file-if-exists=.env dist/src/cli.js feishu",
    "local": "tsx --env-file-if-exists=.env src/cli.ts local",
    "demo": "tsx src/cli.ts demo",
    "doctor": "tsx --env-file-if-exists=.env src/cli.ts doctor",
    "workspaces": "tsx --env-file-if-exists=.env scripts/workspaces.ts",
    "setup:feishu": "tsx scripts/setup-feishu.ts",
    "smoke:codex": "tsx scripts/smoke-codex.ts",
    "smoke:workspace": "tsx scripts/smoke-workspace.ts"
  },
  "dependencies": { "@larksuiteoapi/node-sdk": "1.74.0" },
  "devDependencies": { "@types/node": "^24.0.0", "tsx": "^4.20.0", "typescript": "7.0.2" }
}
